# Copy this file to .env for Ubuntu operation.
# Replace TARGET_CIDR and NETWORK_INTERFACE with values from the Ubuntu host.
# Keep .env private; it is intentionally excluded from Git.
NODE_ENV=production
BIND_ADDRESS=0.0.0.0
PORT=3000
DATABASE_PATH=/app/data/ip-watch.sqlite3
TARGET_CIDR=192.168.1.0/24
NETWORK_INTERFACE=eth0
SCAN_INTERVAL_MS=10000
SCAN_TIMEOUT_MS=10000
PING_TIMEOUT_MS=1000
PING_CONCURRENCY=20
USE_MOCK_SCANNER=false
