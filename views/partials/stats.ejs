<section class="stats" aria-label="통계 요약">
  <article class="stat-card" data-stat-card="total">
    <p class="stat-card__label">전체</p>
    <p class="stat-card__value skeleton" data-stat="total">—</p>
  </article>
  <article class="stat-card" data-stat-card="active">
    <p class="stat-card__label"><span aria-hidden="true">●</span> ACTIVE (사용 중)</p>
    <p class="stat-card__value skeleton" data-stat="active">—</p>
  </article>
  <article class="stat-card" data-stat-card="inactive">
    <p class="stat-card__label"><span aria-hidden="true">◐</span> INACTIVE (과거 사용)</p>
    <p class="stat-card__value skeleton" data-stat="inactive">—</p>
  </article>
  <article class="stat-card" data-stat-card="available">
    <p class="stat-card__label"><span aria-hidden="true">○</span> AVAILABLE (미사용 추정)</p>
    <p class="stat-card__value skeleton" data-stat="available">—</p>
  </article>
  <article class="stat-card stat-card--accent" data-stat-card="allocationCandidates">
    <p class="stat-card__label"><span aria-hidden="true">◆</span> 할당 후보</p>
    <p class="stat-card__value skeleton" data-stat="allocationCandidates">—</p>
    <p class="stat-card__hint">AVAILABLE · 미예약</p>
  </article>
  <article class="stat-card" data-stat-card="reserved">
    <p class="stat-card__label"><span aria-hidden="true">🔒</span> 예약</p>
    <p class="stat-card__value skeleton" data-stat="reserved">—</p>
    <p class="stat-card__hint">중복 지표</p>
  </article>
</section>
